      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfor (const item of $input.all()) {\n  const binaryKey = Object.keys(item.binary)[0] || 'data';\n  const base64Data = item.binary[binaryKey].data;\n\n  // Calculate MD5 Checksum of the binary payload\n  item.json.fileHash = crypto.createHash('md5').update(base64Data, 'base64').digest('hex');\n  item.json.fileId = item.json.id;\n  item.json.fileName = item.json.name;\n}\nreturn $input.all();"
      },
